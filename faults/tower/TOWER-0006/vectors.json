        {
          "output": "yLowBasinTemp",
          "from_s": 0,
          "to_s": 4200,
          "equals": false
        },
        {
          "output": "yFault",
          "from_s": 0,
          "to_s": 4200,
          "equals": false
        }
      ]
    },
