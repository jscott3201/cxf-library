        {
          "output": "yTooWarm",
          "from_s": 0,
          "to_s": 540,
          "equals": true
        },
        {
          "output": "yTooWarm",
          "from_s": 600,
          "to_s": 840,
          "equals": false
        },
        {
          "output": "yTooWarm",
          "from_s": 900,
          "to_s": 1500,
          "equals": true
        }
      ]
    },
