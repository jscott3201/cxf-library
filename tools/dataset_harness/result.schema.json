{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-control-library.example/schemas/dataset-validation-v1.json",
  "title": "Open Control Library external-dataset validation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "adapter", "execution", "dataset", "selection", "summary", "results", "notes"],
  "properties": {
    "schema": {"const": "cxf-library/dataset-validation/v1"},
    "adapter": {"type": "string", "minLength": 1},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["library_git_revision", "library_git_dirty", "engine_pin", "engine_source_revisions", "verifier", "tool_sha256", "point_dictionary_sha256", "rules"],
      "properties": {
        "library_git_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "library_git_dirty": {"type": "boolean"},
        "engine_pin": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "engine_source_revisions": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "uniqueItems": true, "maxItems": 1},
        "verifier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "path", "sha256"],
          "properties": {
            "mode": {"enum": ["repository-default", "repository-binary", "explicit-untrusted"]},
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        },
        "tool_sha256": {
          "type": "object",
          "minProperties": 3,
          "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "point_dictionary_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "rules": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["engine_source_revision", "rule_content_id", "graph_sha256", "card_sha256"],
            "properties": {
              "engine_source_revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
              "rule_content_id": {"type": ["string", "null"]},
              "graph_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "card_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "doi", "inventory", "version", "local_fingerprint", "cases"],
      "properties": {
        "name": {"type": "string"},
        "doi": {"type": "string"},
        "inventory": {"type": "string"},
        "version": {"type": "string"},
        "local_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "cases": {"type": "integer", "minimum": 1}
      }
    },
    "selection": {
      "type": "object",
      "required": ["rules", "cases", "subtype", "case_kind", "severity", "start", "end"],
      "properties": {
        "rules": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "cases": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "subtype": {"type": ["string", "null"]},
        "case_kind": {"type": ["string", "null"]},
        "severity": {"type": ["string", "null"]},
        "start": {"type": ["string", "null"]},
        "end": {"type": ["string", "null"]}
      }
    },
    "summary": {"$ref": "#/$defs/metricsSummary"},
    "results": {
      "type": "array",
      "items": {"$ref": "#/$defs/result"}
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "nullableRate": {
      "anyOf": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "null"}
      ]
    },
    "nullableDuration": {
      "anyOf": [
        {"type": "number", "minimum": 0},
        {"type": "null"}
      ]
    },
    "metricsSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "results",
        "evaluable_samples",
        "fault_free_evaluable_samples",
        "fault_free_alarm_samples",
        "fault_free_alarm_episodes",
        "fault_free_alarm_sample_rate",
        "target_detected_rule_case_pairs",
        "target_evaluable_rule_case_pairs",
        "target_declared_rule_case_pairs",
        "target_detection_rate",
        "median_detection_latency_s"
      ],
      "properties": {
        "results": {"type": "integer", "minimum": 0},
        "evaluable_samples": {"type": "integer", "minimum": 0},
        "fault_free_evaluable_samples": {"type": "integer", "minimum": 0},
        "fault_free_alarm_samples": {"type": "integer", "minimum": 0},
        "fault_free_alarm_episodes": {"type": "integer", "minimum": 0},
        "fault_free_alarm_sample_rate": {"$ref": "#/$defs/nullableRate"},
        "target_detected_rule_case_pairs": {"type": "integer", "minimum": 0},
        "target_evaluable_rule_case_pairs": {"type": "integer", "minimum": 0},
        "target_declared_rule_case_pairs": {"type": "integer", "minimum": 0},
        "target_detection_rate": {"$ref": "#/$defs/nullableRate"},
        "median_detection_latency_s": {"$ref": "#/$defs/nullableDuration"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case",
        "rule",
        "subtype",
        "label",
        "inventory_evidence",
        "fault_class",
        "severity",
        "mapping",
        "gating",
        "metrics",
        "notes"
      ],
      "properties": {
        "case": {"type": "string"},
        "rule": {"type": "string", "pattern": "^FPB-[0-9]{4}$"},
        "subtype": {"enum": ["parallel", "series"]},
        "label": {"enum": ["fault_free", "faulted"]},
        "inventory_evidence": {"type": "string", "minLength": 1},
        "fault_class": {"type": ["string", "null"]},
        "severity": {"type": ["string", "null"]},
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonical_to_source", "binding_details", "proxies", "unit_conversions"],
          "properties": {
            "canonical_to_source": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
            "binding_details": {"type": "object", "additionalProperties": {"type": ["object", "null"]}},
            "proxies": {"type": "array", "items": {"type": "object"}},
            "unit_conversions": {"type": "array", "items": {"type": "object"}}
          }
        },
        "gating": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "definitions", "startup_lead_s", "evaluable_samples", "segments", "source_timeline"],
          "properties": {
            "description": {"type": "string"},
            "definitions": {"type": "array", "items": {"type": "object"}},
            "startup_lead_s": {"type": "integer", "minimum": 0},
            "evaluable_samples": {"type": "integer", "minimum": 0},
            "segments": {"type": "integer", "minimum": 0},
            "source_timeline": {"type": "object"}
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evaluable_samples",
            "alarm_samples",
            "alarm_episodes",
            "fault_free_alarm_samples",
            "fault_free_alarm_episodes",
            "fault_free_evaluable_samples",
            "fault_free_alarm_sample_rate",
            "target_post_fault_evaluable_samples",
            "target_post_fault_alarm_samples",
            "target_post_fault_alarm_episodes",
            "target_declared_rule_case_pairs",
            "target_detected_rule_case_pairs",
            "target_evaluable_rule_case_pairs",
            "median_detection_latency_s"
          ],
          "properties": {
            "evaluable_samples": {"type": "integer", "minimum": 0},
            "alarm_samples": {"type": "integer", "minimum": 0},
            "alarm_episodes": {"type": "integer", "minimum": 0},
            "fault_free_alarm_samples": {"type": "integer", "minimum": 0},
            "fault_free_alarm_episodes": {"type": "integer", "minimum": 0},
            "fault_free_evaluable_samples": {"type": "integer", "minimum": 0},
            "fault_free_alarm_sample_rate": {"$ref": "#/$defs/nullableRate"},
            "target_post_fault_evaluable_samples": {"type": "integer", "minimum": 0},
            "target_post_fault_alarm_samples": {"type": "integer", "minimum": 0},
            "target_post_fault_alarm_episodes": {"type": "integer", "minimum": 0},
            "target_declared_rule_case_pairs": {"type": "integer", "minimum": 0, "maximum": 1},
            "target_detected_rule_case_pairs": {"type": "integer", "minimum": 0, "maximum": 1},
            "target_evaluable_rule_case_pairs": {"type": "integer", "minimum": 0, "maximum": 1},
            "median_detection_latency_s": {"$ref": "#/$defs/nullableDuration"}
          }
        },
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
