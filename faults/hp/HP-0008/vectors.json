    {
      "name": "emergency_or_recovery_raw_case",
      "description": "The raw graph alarms on sustained concurrent recovery/emergency heat; the host must exclude an authorized mode.",
      "inputs": {
        "aux_heat_status": true,
        "oat": 6.0,
        "mode_command": 1,
        "defrost_status": false,
        "comp_status": true
