        {
          "output": "yConcurrentHeat",
          "from_s": 0,
          "to_s": 180,
          "equals": true
        },
        {
          "output": "yConcurrentHeat",
          "from_s": 240,
          "to_s": 720,
          "equals": false
        }
      ]
    },
    {
      "name": "mature_fault_recovers_when_auxiliary_clears",
