        },
        {
          "output": "yFault",
          "from_s": 0,
          "to_s": 2100,
          "equals": false
        }
      ]
    },
    {
      "name": "negative_reference_raw_case",
      "description": "A negative reference remains numerically safe and non-evaluable.",
      "inputs": {
        "primary_airflow": 100.0,
        "primary_airflow_reference": -10.0
      },
      "expect": [
        {
          "output": "yReferenceOk",
          "from_s": 0,
          "to_s": 2100,
          "equals": false
        },
        {
          "output": "yPositiveBias",
          "from_s": 0,
