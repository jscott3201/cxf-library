          "output": "yFault",
          "from_s": 0,
          "to_s": 7800,
          "equals": false
        },
        {
          "output": "yFault",
          "from_s": 8100,
          "to_s": 8100,
          "equals": true
        },
        {
          "output": "yFault",
          "from_s": 8700,
          "to_s": 21600,
          "equals": false
