      "inputs": {
        "aux_heat_status": true,
        "oat": 6.0,
        "mode_command": 1,
        "defrost_status": false,
        "comp_status": false
      },
      "expect": [
        {
          "output": "yHeatingMode",
          "from_s": 0,
          "to_s": 720,
          "equals": true
