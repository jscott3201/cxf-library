      },
      "expect": [
        {
          "output": "yFault",
          "from_s": 0,
          "to_s": 1500,
          "equals": false
        },
        {
          "output": "yFault",
          "from_s": 1620,
          "to_s": 3600,
          "equals": true
        }
      ]
    },
    {
      "name": "initialization_violation_waits",
      "description": "A violation present at engine initialization waits the full delay because persist.delayOnInit is true.",
      "inputs": {
        "vfd_speed": 98.0,
        "vfd_process_value": 80.0,
        "vfd_process_sp": 100.0
