      "expect": [
        {
          "output": "yBaselineOk",
          "from_s": 0,
          "to_s": 3600,
          "equals": false
        },
        {
          "output": "yPowerHigh",
          "from_s": 0,
          "to_s": 3600,
          "equals": false
        },
        {
          "output": "yFault",
          "from_s": 0,
          "to_s": 3600,
          "equals": false
        }
      ]
    },
