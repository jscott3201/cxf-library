    {
      "name": "normal_dx_off_cycle_resets_timer",
      "description": "A normal compressor-off interval removes evaluability and resets an immature error episode.",
      "inputs": {
        "sat": 18.0,
        "sat_sp": 15.0,
        "sf_status": true,
        "comp_status": [
          {
            "t": 0,
            "value": true
          },
          {
            "t": 600,
            "value": false
          },
          {
            "t": 900,
            "value": true
          }
        ],
        "htg_status": false
      },
      "expect": [
        {
          "output": "yFault",
          "from_s": 0,
          "to_s": 1500,
          "equals": false
