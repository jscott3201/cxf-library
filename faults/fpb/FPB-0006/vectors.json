      "expect": [
        {
          "output": "yBaselineOk",
          "from_s": 0,
          "to_s": 2100,
          "equals": false
        },
        {
          "output": "yTemperatureRiseLow",
          "from_s": 0,
          "to_s": 2100,
          "equals": false
        },
        {
          "output": "yFault",
          "from_s": 0,
          "to_s": 2100,
          "equals": false
        }
      ]
    },
