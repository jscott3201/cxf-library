      "expect": [
        {
          "output": "yFault",
          "from_s": 0,
          "to_s": 840,
          "equals": false
        },
        {
          "output": "yFault",
          "from_s": 960,
          "to_s": 1140,
          "equals": true
        },
        {
          "output": "yFault",
          "from_s": 1260,
          "to_s": 3600,
          "equals": false
        },
        {
          "output": "yTooWarm",
          "from_s": 0,
          "to_s": 1140,
          "equals": true
        },
        {
          "output": "yTooWarm",
          "from_s": 1260,
          "to_s": 3600,
          "equals": false
        }
      ]
    },
    {
      "name": "setpoint_step_then_recovery",
      "description": "A setpoint reset step creates a short raw error that recovers before persistence; hosts should also exclude unsettled ramps.",
