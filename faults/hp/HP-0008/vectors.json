    {
      "name": "auxiliary_stage_ends_one_step_before_persistence",
      "description": "An auxiliary stage ending one evaluator step before 300 s never matures.",
      "inputs": {
        "aux_heat_status": [
          {
            "t": 0,
            "value": true
          },
          {
            "t": 240,
            "value": false
          }
        ],
        "oat": 6.0,
        "mode_command": 1,
        "defrost_status": false,
        "comp_status": true
