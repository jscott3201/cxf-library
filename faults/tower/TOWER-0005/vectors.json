        {
          "output": "yOvercooled",
          "from_s": 0,
          "to_s": 2400,
          "equals": true
        },
        {
          "output": "yFanLoaded",
          "from_s": 0,
          "to_s": 2400,
          "equals": true
        },
        {
          "output": "yFault",
          "from_s": 0,
          "to_s": 540,
          "equals": false
        },
        {
          "output": "yFault",
          "from_s": 660,
          "to_s": 2400,
          "equals": true
        }
      ]
    },
    {
      "name": "temperature_exact_boundary_clear",
