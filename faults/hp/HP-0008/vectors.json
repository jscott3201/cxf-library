        {
          "output": "yFault",
          "from_s": 360,
          "to_s": 360,
          "equals": true
        },
        {
          "output": "yFault",
          "from_s": 420,
          "to_s": 720,
          "equals": false
        },
        {
          "output": "yConcurrentHeat",
          "from_s": 0,
          "to_s": 360,
          "equals": true
        },
        {
          "output": "yConcurrentHeat",
          "from_s": 420,
          "to_s": 720,
          "equals": false
        }
      ]
    },
