          {
            "t": 16200,
            "value": 14.15
          },
          {
            "t": 18000,
            "value": 14.0
          },
          {
            "t": 19800,
            "value": 14.15
          },
          {
            "t": 21600,
            "value": 14.0
          }
        ],
        "equip_active": true
      },
      "expect": [
        {
          "output": "yFault",
          "from_s": 0,
          "to_s": 7800,
          "equals": false
