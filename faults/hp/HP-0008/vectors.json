        {
          "output": "yConcurrentHeat",
          "from_s": 0,
          "to_s": 720,
          "equals": false
        },
        {
          "output": "yFault",
          "from_s": 0,
          "to_s": 720,
          "equals": false
        }
      ]
    },
    {
      "name": "auxiliary_above_lockout_compressor_off",
